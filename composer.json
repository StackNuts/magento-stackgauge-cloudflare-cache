{
  "name": "stacknuts/magento-stackgauge-cloudflare-cache",
  "description": "Compatibility module: reports StackNuts_CloudflareCache's purge-queue status into a StackNuts_StackGauge fleet report. Contains only glue code - install it alongside both parent modules to enable the integration.",
  "type": "magento2-module",
  "keywords": ["magento2", "cloudflare", "stackgauge", "compatibility", "bridge"],
  "homepage": "https://github.com/StackNuts/magento-stackgauge-cloudflare-cache",
  "authors": [
    {
      "name": "Phil Rowe",
      "email": "stack.nuts@outlook.com"
    }
  ],
  "support": {
    "issues": "https://github.com/StackNuts/magento-stackgauge-cloudflare-cache/issues",
    "source": "https://github.com/StackNuts/magento-stackgauge-cloudflare-cache"
  },
  "license": "PolyForm-Shield-1.0.0",
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
    "magento/framework": ">=103.0 <104",
    "stacknuts/magento-cloudflare-cache": ">=2.0 <3.0",
    "stacknuts/magento-stackgauge": ">=0.1 <1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "StackNuts\\StackGaugeCloudflareCache\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StackNuts\\StackGaugeCloudflareCache\\Test\\": "Test/"
    }
  }
}
